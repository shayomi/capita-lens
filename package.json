{
  "name": "sadora-lens",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @sadora/db generate",
    "db:migrate": "pnpm --filter @sadora/db migrate",
    "db:push": "pnpm --filter @sadora/db push",
    "db:seed": "pnpm --filter @sadora/db seed",
    "db:studio": "pnpm --filter @sadora/db studio",
    "format": "prettier --write \"**/*.{ts,tsx,md}\""
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3"
  }
}
