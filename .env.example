# ─────────────────────────────────────────────────────────────
# Capita-Lens — Environment
# Copy to `.env` at the repo root. Both apps read from here.
# ─────────────────────────────────────────────────────────────

# Neon Postgres — connection string (use the POOLED connection string)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Neon Managed Better Auth — from the Neon console → Auth tab → Configuration
# NEON_AUTH_BASE_URL is the "Auth URL" shown there (ends in /neondb/auth).
# Generate the cookie secret with: openssl rand -base64 32
NEON_AUTH_BASE_URL=""
NEON_AUTH_COOKIE_SECRET=""

# Comma-separated emails auto-promoted to super_admin on first sign-in.
SUPER_ADMIN_EMAILS=""

# OpenAI — powers AI assessment analysis. If unset, the deterministic
# scoring engine is used as a fallback (no AI narrative).
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o"

# Cloudflare R2 — S3-compatible credentials
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="capita-lens"
# Public base URL for served files (R2 public bucket or custom domain)
R2_PUBLIC_URL=""

# App URLs (used for auth redirects / links between apps)
NEXT_PUBLIC_WEB_URL="http://localhost:3000"
NEXT_PUBLIC_ADMIN_URL="http://localhost:3001"
